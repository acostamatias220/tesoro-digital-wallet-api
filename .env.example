# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Database ---
DB_USER=tesoro
# Choose a strong password for the local PostgreSQL container
DB_PASSWORD=
# Only needed when running the app outside Docker
DB_URL=jdbc:postgresql://localhost:5432/tesoro

# --- Security ---
# HMAC key for the access tokens (min. 32 characters). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# First administrator, created on startup if both are set (password: min. 12 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Exchange rate ---
# mock = fixed USD/ARS quote (FX_MOCK_BID / FX_MOCK_ASK); dolarapi = official rate from dolarapi.com
FX_PROVIDER=mock
FX_MOCK_BID=1400.00
FX_MOCK_ASK=1450.00

# --- Demo data ---
# true = creates ana@tesoro.dev and bruno@tesoro.dev with some movements
SEED_DEMO_DATA=false
# Password for the demo users. If empty, a random one is generated and printed in the logs.
SEED_PASSWORD=

# --- Tests (integration tests use their own database) ---
TEST_DB_URL=jdbc:postgresql://localhost:5432/tesoro_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=
